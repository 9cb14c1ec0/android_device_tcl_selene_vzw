# Based on stock vendor_boot init.recovery.mt6835.rc (selene_vzw).

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop vendor.usb.controller "11201000.usb0"
    mkdir /mnt/vendor 0755 root system
    mkdir /mnt/vendor/persist 0771 system system
    mkdir /mnt/vendor/nvdata 0771 system system
    mkdir /mnt/vendor/nvcfg 0771 system system
    mkdir /mnt/vendor/protect_f 0771 system system
    mkdir /mnt/vendor/protect_s 0771 system system

on post-fs
    # A/B eMMC boot regions (stock)
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b
    symlink /dev/block/by-name/preloader_a /dev/block/by-name/preloader_emmc_a
    symlink /dev/block/by-name/preloader_b /dev/block/by-name/preloader_emmc_b

on boot
    write /sys/class/leds/lcd-backlight/brightness 2400

# --- Trustonic TEE + KeyMint/Gatekeeper for FBE/metadata decryption ---
# Stock: vendor/etc/init/{trustonic,vendor.trustonic.tee@1.1-service,
# android.hardware.security.keymint@2.0-service.trustonic,
# android.hardware.gatekeeper@1.0-service}.rc. Registry lives on tmpfs
# (see selene_tee_prep.sh); only drbins present on vendor are listed.
on fs
    # Stock vendor/etc/ueventd.rc ownership (recovery ueventd lacks it).
    chown system system /dev/mobicore
    chmod 0600 /dev/mobicore
    chown system system /dev/mobicore-user
    chmod 0666 /dev/mobicore-user
    chown system system /dev/teeperf
    chmod 0666 /dev/teeperf
    exec u:r:recovery:s0 root root -- /system/bin/selene_tee_prep.sh
    start mobicore

on property:init.svc.mobicore=running
    exec u:r:recovery:s0 root root -- /system/bin/sleep 1
    start tee-1-1
    start vendor.keymint-trustonic
    start vendor.gatekeeper-1-0

service mobicore /vendor/bin/mcDriverDaemon --sfs-reformat --P1 /tmp/mcRegistry \
        -r /vendor/app/mcRegistry/06090000000000000000000000000000.drbin \
        -r /vendor/app/mcRegistry/020f0000000000000000000000000000.drbin \
        -r /vendor/app/mcRegistry/05120000000000000000000000000001.drbin \
        -r /vendor/app/mcRegistry/40188311faf343488db888ad39496f9a.drbin \
        -r /vendor/app/mcRegistry/5020170115e016302017012521300000.drbin
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    disabled
    oneshot
    seclabel u:r:recovery:s0

service tee-1-1 /vendor/bin/hw/vendor.trustonic.tee@1.1-service
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-trustonic /vendor/bin/hw/android.hardware.security.keymint@2.0-service.trustonic
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user system
    group system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0
