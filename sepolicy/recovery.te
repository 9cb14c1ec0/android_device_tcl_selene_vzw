# Bring-up: the kernel cmdline comes from LK, so androidboot.selinux=permissive
# cannot be injected. Keep the recovery domain permissive until a proper
# policy is written (eng builds only).
permissive recovery;

# Bring-up: early unauthenticated adb must work even if the adbd policy
# for this vendor is incomplete. (su is already permissive on eng.)
permissive adbd;
