// NXTPAPER key and display modes. The key handler is loaded into
// system_server by PhoneWindowManager (config_deviceKeyHandlerLibs in
// overlay-lineage); the app process only hosts the Quick Settings tile.
android_app {
    name: "NxtPaper",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    required: ["privapp_whitelist_org.lineageos.nxtpaper"],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.nxtpaper",
    src: "privapp_whitelist_org.lineageos.nxtpaper.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}
